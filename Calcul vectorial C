#include <stdio.h>
#include <math.h>

int main(void) {
    int n=0;
    double a[100],b[100],suma[100];
    
    scanf("%d",&n);
    
    for(int i=0; i<n; i++) {
        scanf("%lf",&a[i]);
    }
    
    for(int i=0; i<n; i++) {
        scanf("%lf",&b[i]);
    }
    
    for(int i=0; i<n; i++) {
        suma[i]=a[i]+b[i];
    }
    
    double produsScalar=0;
    for(int i=0; i<n; i++) {
        produsScalar+=a[i]*b[i];
    }
    
    double normaA=0,normaB=0;
    for(int i=0; i<n; i++) {
        normaA+=a[i]*a[i];
        normaB+=b[i]*b[i];
    }
    
    normaA=sqrt(normaA);
    normaB=sqrt(normaB);
    
    printf("Produs scalar: %.2f\n",produsScalar);
    printf("Norma vector A: %.2f, Norma vector B: %.2f\n",normaA,normaB);
    printf("Vectorul suma: ");
    
    for(int i=0; i<n; i++) {
        printf("%.2f ",suma[i]);
    }
    
    printf("\n");
    
    return 0;
}
